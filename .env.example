# ─────────────────────────────────────────
# CHEMEXTRACT AI — LOCAL CONFIGURATION
# ─────────────────────────────────────────

# LLM PROVIDER: auto | ollama | gemini | groq
LLM_PROVIDER=auto

# LLM credentials (only fill the one you use)
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120

# GRAPH STORAGE: obsidian | neo4j | networkx | sqlite
GRAPH_BACKEND=obsidian

# Obsidian vault path (if GRAPH_BACKEND=obsidian)
OBSIDIAN_VAULT_PATH=~/ChemExtract/vault

# Neo4j connection (if GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=chemextract123

# SQLite path (if GRAPH_BACKEND=sqlite)
SQLITE_PATH=./data/chemextract.db

# PRIVACY MODE: true = no external API calls, local files only
PRIVACY_MODE=false

# Paper sources (comma separated, or "all")
ACTIVE_SOURCES=pubmed,arxiv,openalex,semantic_scholar

# Optional: your email for API polite pools
API_EMAIL=your.email@example.com
PUBMED_EMAIL=your.email@example.com
